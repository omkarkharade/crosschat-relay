{
  "name": "crosschat-relay",
  "version": "0.1.0",
  "description": "A durable MCP inbox/outbox that lets separately-run AI agents hand each other tasks.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "multi-agent",
    "task-queue",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "author": "omkarkharade",
  "homepage": "https://github.com/omkarkharade/crosschat-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkarkharade/crosschat-relay.git"
  },
  "bugs": {
    "url": "https://github.com/omkarkharade/crosschat-relay/issues"
  },
  "type": "module",
  "bin": {
    "crosschat-relay": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:demo": "vite --config web/vite.config.ts --mode demo",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
