# Copy to .env and adjust. Values already set in the environment win over this file.

# Admin token (dashboard, REST API, MCP as any agent). Leave unset to generate one into <data-dir>/api-token.
# CROSSCHAT_API_TOKEN=

# CROSSCHAT_PORT=4318
# CROSSCHAT_HOST=127.0.0.1
# CROSSCHAT_DATA_DIR=./data

# Required when CROSSCHAT_HOST is not a loopback address.
# CROSSCHAT_ALLOWED_HOSTS=relay.example.com
# CROSSCHAT_ALLOWED_ORIGINS=relay.example.com

# CROSSCHAT_TASK_RETENTION_DAYS=30

# Agent slug that dashboard-posted tasks come from.
# CROSSCHAT_OPERATOR_SLUG=operator
